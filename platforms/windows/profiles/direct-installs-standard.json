{
  "packages": [
    {
      "name": "FileZilla",
      "required": true,
      "localInstallerPattern": "FileZilla_*_win64-setup.exe",
      "downloadUri": "https://sourceforge.net/projects/filezilla/files/latest/download",
      "manualDownloadUri": "https://filezilla-project.org/download.php?show_all=1",
      "allowedDownloadHosts": [
        "sourceforge.net",
        "*.dl.sourceforge.net"
      ],
      "publisherPattern": "FileZilla Project|Tim Kosse",
      "silentArguments": [
        "/S"
      ],
      "detectionPaths": [
        "%ProgramFiles%\\FileZilla FTP Client\\filezilla.exe",
        "%ProgramFiles(x86)%\\FileZilla FTP Client\\filezilla.exe"
      ]
    },
    {
      "name": "Visual C++ v14 Runtime (x64)",
      "required": true,
      "downloadUri": "https://aka.ms/vs/17/release/vc_redist.x64.exe",
      "allowedDownloadHosts": ["aka.ms", "download.visualstudio.microsoft.com", "download.microsoft.com"],
      "publisherPattern": "O=Microsoft Corporation(?:,|$)",
      "silentArguments": ["/install", "/quiet", "/norestart"],
      "detectionRegistry": "HKLM:\\SOFTWARE\\Microsoft\\VisualStudio\\14.0\\VC\\Runtimes\\x64",
      "detectionPaths": []
    },
    {
      "name": "balena Etcher",
      "required": true,
      "githubRepository": "balena-io/etcher",
      "assetNamePattern": "^balenaEtcher-[0-9.]+\\.Setup\\.exe$",
      "downloadUri": "https://github.com/balena-io/etcher/releases/latest",
      "manualDownloadUri": "https://github.com/balena-io/etcher/releases",
      "allowedDownloadHosts": [
        "github.com",
        "release-assets.githubusercontent.com",
        "objects.githubusercontent.com"
      ],
      "publisherPattern": "balena|resin",
      "silentArguments": [
        "/S"
      ],
      "detectionPaths": [
        "%LOCALAPPDATA%\\Programs\\balena-etcher\\balenaEtcher.exe",
        "%LOCALAPPDATA%\\balena_etcher\\balenaEtcher.exe",
        "%ProgramFiles%\\balenaEtcher\\balenaEtcher.exe",
        "%ProgramFiles%\\balena-etcher\\balenaEtcher.exe"
      ]
    }
  ]
}
